  "description": "Subquantum Graphity (SubQG 1.0) - relational gravity research runtime with explicitly audited empirical limits",
  "type": "module",
  "main": "src/index.mjs",
  "types": "src/index.d.ts",
  "scripts": {
    "start": "node src/index.mjs",
