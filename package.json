    "validation:sparc": "node validation/scripts/sparc_rotation_validation.mjs",
    "validation:little-things": "node validation/scripts/little_things_validation.mjs",
    "validation:lensing": "node validation/scripts/lensing_ppn_validation.mjs",
    "validation:spin2-bridge": "node validation/scripts/spin2_bridge_audit.mjs",
    "validation:solar-system": "node validation/scripts/solar_system_perihelion_validation.mjs",
    "validation:local-gravity": "node validation/scripts/local_gravity_validation.mjs",
    "validation:binary-pulsar": "node validation/scripts/binary_pulsar_validation.mjs",
    "validation:gravitational-waves": "node validation/scripts/gravitational_wave_validation.mjs",
    "validation:simplex-tensor-bridge": "node validation/scripts/simplex_tensor_bridge.mjs",
    "validation:collective-spin2-hessian": "node validation/scripts/collective_spin2_hessian.mjs",
    "validation:cosmology": "node validation/scripts/cosmology_validation.mjs",
    "validation:background-bao": "node validation/scripts/subqg_background_bao_validation.mjs"
  },
  "keywords": [
    "quantum-gravity",
